package cmd

import (
	"context"
	"os"

	"charm.land/fang/v2"
	"charm.land/lipgloss/v2"
	"github.com/spf13/cobra"
	"github.com/spf13/viper"
{% if ci_platform == 'gitlab' -%}
	"{{ gitlab_url }}/{{ project_name }}/src/{{ tool_name }}/config"
	"{{ gitlab_url }}/{{ project_name }}/src/{{ tool_name }}/version"
{%- else -%}
	"github.com/{{ github_registry | replace('ghcr.io/', '') }}/src/{{ tool_name }}/config"
	"github.com/{{ github_registry | replace('ghcr.io/', '') }}/src/{{ tool_name }}/version"
{%- endif %}
)

var (
	cfgFile   string
	AppConfig *config.Config
)

var rootCmd = &cobra.Command{
	Use:   "{{ tool_name }}",
	Short: "{{ project_name }} CLI tool",
	Long: `{{ project_name }} is a CLI tool built with Cobra.

Configure it using a config file, environment variables, or flags.`,
}

// Execute runs the root command through Fang, which provides styled help,
// usage and error output, an automatic --version flag, shell completions and
// man pages. Color degrades automatically under NO_COLOR / non-TTY.
func Execute() {
	if err := fang.Execute(
		context.Background(),
		rootCmd,
		fang.WithVersion(version.Version),
		fang.WithCommit(version.Commit),
		fang.WithColorSchemeFunc(brandColorScheme),
	); err != nil {
		os.Exit(1)
	}
}

func init() {
	cobra.OnInitialize(initConfig)
	rootCmd.PersistentFlags().StringVar(&cfgFile, "config", "", "config file (default is ./config/{{ tool_name }}.yaml)")
}

func initConfig() {
	config.Defaults()

	if cfgFile != "" {
		viper.SetConfigFile(cfgFile)
	} else {
		viper.SetConfigName("{{ tool_name }}")
		viper.SetConfigType("yaml")
		viper.AddConfigPath("./config")
		viper.AddConfigPath(".")
	}

	config.SetupEnv()

	if err := viper.ReadInConfig(); err == nil {
		lipgloss.Fprintln(os.Stderr, labelStyle.Render("Using config file:"), viper.ConfigFileUsed())
	}

	cfg, err := config.Load()
	if err != nil {
		lipgloss.Fprintln(os.Stderr, errorStyle.Render("Error loading config:"), err.Error())
		os.Exit(1)
	}
	AppConfig = cfg
}
